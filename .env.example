# Скопируйте в .env и заполните, если нужен живой сбор из Telegram.

# Токен бота от @BotFather. Без него каталог работает с импортом экспорта чата.
TELEGRAM_BOT_TOKEN=

# Необязательно: только этот чат будет обрабатываться ботом.
# Узнать id: добавьте бота в чат и напишите /chatid
TELEGRAM_CHAT_ID=

# Необязательно: пароль на вход в каталог (логин любой).
CATALOG_PASSWORD=

# Папка с данными (фото + база). По умолчанию ./data
DATA_DIR=data
