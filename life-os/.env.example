# Ключ OpenAI нужен только ассистенту и расшифровке голоса.
# Без него приложение полностью работает вручную, а простые фразы разбирает локально.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Если задан, приложение спрашивает пароль при входе. Пусто — локальный режим без входа.
LIFEOS_ACCESS_PASSWORD=

# Секрет для шифрования пароля приложения Apple. Задайте свой в проде.
LIFEOS_SECRET=

# Часовой пояс по умолчанию для нового профиля.
LIFEOS_TZ=Asia/Bangkok
